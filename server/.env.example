# Copy to .env and fill in. `npm start` loads this via node --env-file.

# HTTP port
PORT=4000

# SQLite file (relative to server/)
DB_PATH=./sonicaccess.db

# Bearer tokens — generate long random strings, keep secret.
#   ADMIN_TOKEN  registrar / provisioning tools (create+revoke students, rotate secrets)
#   NODE_TOKEN   the ESP32 gate nodes (pull the secret map, POST access events)
#   READ_TOKEN   dashboards / monitoring (read occupancy)
# A role with no token set is refused (fail closed).
ADMIN_TOKEN=
NODE_TOKEN=
READ_TOKEN=

# Set true only if the live occupancy count may be read with no auth (kiosk display).
PUBLIC_OCCUPANCY=false

# Set false to silence the per-request JSON access log.
LOG_REQUESTS=true
