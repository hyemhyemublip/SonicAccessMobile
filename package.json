{
  "name": "sonicaccessmobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "buffer": "^6.0.3",
    "expo": "~57.0.20",
    "expo-audio": "~57.0.4",
    "expo-file-system": "~57.0.6",
    "expo-secure-store": "^57.0.3",
    "expo-status-bar": "~57.0.1",
    "js-sha1": "^0.7.0",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "selftest": "node --experimental-strip-types scripts/token-selftest.mjs",
    "test:audio": "node --experimental-strip-types scripts/roundtrip-test.mjs",
    "test:e2e": "node --experimental-strip-types --experimental-sqlite scripts/e2e-test.mjs",
    "decode": "node --experimental-strip-types scripts/fsk-decoder.mjs",
    "gate-sim": "node --experimental-strip-types scripts/gate-sim.mjs",
    "seed": "node --experimental-strip-types scripts/seed-students.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck && npm run selftest && npm run test:audio && npm run test:e2e",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "private": true
}
